# SAMS Backend — Environment Variables Template
# คัดลอกเป็น .env แล้วกรอกค่าจริง ห้าม Commit .env ลง Git

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database — Supabase PostgreSQL
DB_ENGINE=postgresql
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_HOST=  # เช่น db.<project-ref>.supabase.co หรือ pooler host
DB_PORT=5432
DB_SSLMODE=require
DB_CONN_MAX_AGE=0

# JWT lifetimes
ACCESS_TOKEN_LIFETIME_MINUTES=10
REFRESH_TOKEN_LIFETIME_DAYS=7

# QR attendance policy
ATTENDANCE_QR_TTL_SECONDS=30
ATTENDANCE_CHECKIN_GRACE_SECONDS=0
ATTENDANCE_LATE_THRESHOLD_MINUTES=15

# Timezone
TIME_ZONE=Asia/Bangkok

# Optional: ใช้กับ `python manage.py create_admin --password-env SAMS_ADMIN_PASSWORD` (CI เท่านั้น)
SAMS_ADMIN_PASSWORD=
