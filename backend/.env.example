# SAMS Backend — Environment Variables Template
# คัดลอกเป็น .env แล้วกรอกค่าจริง ห้าม Commit .env ลง Git

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database — Supabase PostgreSQL
DB_ENGINE=postgresql
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_HOST=  # เช่น db.<project-ref>.supabase.co หรือ pooler host
DB_PORT=5432
DB_SSLMODE=require
DB_CONN_MAX_AGE=0

# JWT lifetimes
ACCESS_TOKEN_LIFETIME_MINUTES=10
REFRESH_TOKEN_LIFETIME_DAYS=7

# Keycloak (OIDC) — optional; set KEYCLOAK_ENABLED=true to turn on
KEYCLOAK_ENABLED=True
KEYCLOAK_BASE_URL=https://keycloak.example.ac.th
KEYCLOAK_REALM=scphtrang
KEYCLOAK_CLIENT_ID=sams
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=https://sams.example.ac.th/api/v1/auth/keycloak/callback/
KEYCLOAK_ISSUER=https://keycloak.example.ac.th/realms/scphtrang
KEYCLOAK_JWKS_URI=https://keycloak.example.ac.th/realms/scphtrang/protocol/openid-connect/certs
KEYCLOAK_SCOPES=openid profile email
KEYCLOAK_END_SESSION_ON_LOGOUT=false
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=
FRONTEND_BASE_URL=http://localhost:3000
# Auto-link first login: only when email_verified true and matches exactly one active SAMS user
KEYCLOAK_AUTO_LINK_BY_VERIFIED_EMAIL=false
# Optional comma-separated email domains allowed for auto-link (e.g. scphtrang.ac.th)
KEYCLOAK_AUTO_LINK_ALLOWED_DOMAINS=

# QR attendance policy
ATTENDANCE_QR_TTL_SECONDS=30
ATTENDANCE_CHECKIN_GRACE_SECONDS=0
ATTENDANCE_LATE_THRESHOLD_MINUTES=15

# Timezone
TIME_ZONE=Asia/Bangkok

# Optional: ใช้กับ `python manage.py create_admin --password-env SAMS_ADMIN_PASSWORD` (CI เท่านั้น)
SAMS_ADMIN_PASSWORD=
